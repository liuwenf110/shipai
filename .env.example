# 厂派/上十派 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，切勿提交真实凭据。
# 生产环境的 .env 在服务器 /home/tuoniao/apps/shipai/.env，改完需 systemctl --user restart shipai。

# ── 数据库 ──
# SQLite 连接串，相对路径以 prisma/ 为基准
DATABASE_URL="file:./dev.db"

# ── 会话 ──
SESSION_COOKIE="shipai_session"
SESSION_DAYS="30"

# ── 开发模式 ──
# true 时邮箱验证码直接在页面回显，无需真实 SMTP；生产必须为 false
NEXT_PUBLIC_DEV_MODE="true"

# ── 邮件（留空则自动走开发模式直出验证码）──
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# 全局每日发信上限，达到后拒发新验证码
MAIL_DAILY_LIMIT="100"

# ── 注册限流（按 X-Forwarded-For 的客户端 IP 滑动窗口计数）──
REGISTER_IP_WINDOW_MIN="60"
REGISTER_IP_MAX="30"

# ── 微信小程序与服务端内容安全（msgSecCheck / mediaCheckAsync）──
# AppID 与 AppSecret 只在服务端读取，绝不可写进小程序前端代码
WX_APPID=""
WX_SECRET=""
# true 时不请求微信接口、直接放行（本地无凭据时用）
WX_MOCK=""
# 对外 HTTPS 域名，用于生成太阳码与回调地址
WX_PUBLIC_ORIGIN="https://www.xiaomaizhipin.com"
# MP 后台「消息推送」配置的 Token，需与后台完全一致；随机 40 位 hex
WX_PUSH_TOKEN=""
